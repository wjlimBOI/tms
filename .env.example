# Copy this file to .env (or .env.local) and fill in real values.
# See README.md's "Set up environment variables" section for details on
# each variable, including which are required vs. optional/degrade-gracefully.

# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Once real encrypted data exists, never change this value.
LOCAL_ENCRYPTION_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist; defaults to localhost if unset.
ALLOWED_ORIGINS=

# ── Outbound email (stage notifications, tender requests, password reset) ─
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TEAM_EMAIL=

# ── Raw pg.Pool TLS (src/lib/db.ts) ─────────────────────────────────────
# Verifies server certificates by default in production. Only set these
# for a genuine emergency/non-standard CA setup.
DB_SSL_CA_PATH=
DB_SSL_REJECT_UNAUTHORIZED=

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────
# Without these, rate limiting is a no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# ── AI description generation ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Scheduled jobs (GET /api/cron/run) ──────────────────────────────────
# Endpoint refuses all requests if unset.
CRON_SECRET=
