# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===== ADDED SECTIONS =====

# Generated Prisma files - IGNORE ALL GENERATED FILES
/src/lib/generated/
/prisma/generated/
/lib/generated/
!src/lib/generated/.gitkeep
!/prisma/generated/.gitkeep

# Ad hoc scratch/debug scripts (not the Vitest suite — *.test.ts is tracked)
/test-db.js
/test-pg.js
test-*.js
test-*.ts

/test-results/
/playwright-report/
/cypress/

# Project tree files
project_tree.txt
tree.tx
tree.txt
*.tree.txt
project-structure.txt
folder-structure.txt

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
out/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux files
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache
.stylelintcache

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.local
.env.*.local

# parcel-bundler cache
.cache
.parcel-cache

# Gatsby files
.cache/
public/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/
*.tmp

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Backup files
*.bak
*.backup
*.old
*.orig

# Upload directories (if you have file uploads)
/uploads/
/public/uploads/
/private/uploads/
/tender-documents/
/bq-templates/

# Prisma
/prisma/*.db
/prisma/*.sqlite
/prisma/*.sqlite3
/prisma/migrations/*.sqlite

# Coverage
coverage/
.nyc_output/

# Testing artifacts
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# Application specific
/temp-uploads/
/sessions/
/cache/

# Performance test artifacts
.artillery/
load-test-results/

# Architecture decision records
docs/adr/*.html

# Cloud credentials — named patterns only, NOT a blanket *.json. A broad
# *.json rule silently drops real app config (components.json, any future
# .json config file) from commits with no warning; confirmed to have already
# dropped components.json from this repo.
.aws/
.azure/
*-service-account.json
*-credentials.json
service-account*.json
gcp-key*.json

# Sensitive data
*.key
*.pem
*.crt
*.csr
*.cer
*.p12
*.pfx

# Generated types
/types/generated/
/src/types/generated/

# Claude Code local tooling/session files - not part of the shipped app
/.claude/
master-session-prompt.md

# ===== IF USING SRC DIRECTORY =====
# If you're using src/ directory, you might want to ignore duplicate root files
# Uncomment if you've migrated everything to src/
# /app/
# /pages/
# /styles/

# ===== OPTIONAL: KEEP DIRECTORY STRUCTURE =====
# If you want to keep empty directories in git
# !.gitkeep

# Ad hoc scratch build output — not a blanket *.css (that would drop any
# real stylesheet from commits with no warning).
test-output.css
