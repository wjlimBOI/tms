  tender_document                                                         tender_document[]
  tender_document_download                                                tender_document_download[]
  tender_extension_requests_tender_extension_requests_approved_byTousers  tender_extension_requests[]   @relation("tender_extension_requests_approved_byTousers")
  tender_extension_requests_tender_extension_requests_requested_byTousers tender_extension_requests[]   @relation("tender_extension_requests_requested_byTousers")
  tender_interest_tender_interest_approved_byTousers                      tender_interest[]             @relation("tender_interest_approved_byTousers")
  tender_interest_tender_interest_contractor_idTousers                    tender_interest[]             @relation("tender_interest_contractor_idTousers")
  tender_message_tender_message_contractor_idTousers                      tender_message[]              @relation("tender_message_contractor_idTousers")
  tender_message_tender_message_sender_idTousers                          tender_message[]              @relation("tender_message_sender_idTousers")
  tender_requests                                                         tender_requests[]
  tender_submission                                                       tender_submission[]
  user_profile                                                            user_profile?
  user_roles_user_roles_assigned_byTousers                                user_roles[]                  @relation("user_roles_assigned_byTousers")
  user_roles_user_roles_user_idTousers                                    user_roles[]                  @relation("user_roles_user_idTousers")
  roles                                                                   roles                         @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active, is_deleted], map: "idx_users_active")
}

model work_category {
  category_id          Int                    @id @default(autoincrement()) @db.SmallInt
  category_name        String                 @unique @db.VarChar(120)
  sort_order           Int                    @default(0) @db.SmallInt
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  bq_line_item         bq_line_item[]
  submission_category  submission_category[]
  tender_work_category tender_work_category[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tender_extension_requests {
  id                                                  Int       @id @default(autoincrement())
  tender_id                                           Int
  requested_by                                        Int
  requested_days                                      Int
  reason                                              String
  original_closing_date                               DateTime  @db.Timestamp(6)
  proposed_closing_date                               DateTime  @db.Timestamp(6)
  status                                              String?   @default("Pending") @db.VarChar(20)
  approved_by                                         Int?
  approved_at                                         DateTime? @db.Timestamp(6)
  created_at                                          DateTime? @default(now()) @db.Timestamp(6)
  updated_at                                          DateTime? @default(now()) @db.Timestamp(6)
  users_tender_extension_requests_approved_byTousers  users?    @relation("tender_extension_requests_approved_byTousers", fields: [approved_by], references: [user_id], onUpdate: NoAction)
  users_tender_extension_requests_requested_byTousers users     @relation("tender_extension_requests_requested_byTousers", fields: [requested_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  tender                                              tender    @relation(fields: [tender_id], references: [tender_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_extension_status")
  @@index([tender_id], map: "idx_extension_tender_id")
}

model tender_extension_settings {
  id          Int       @id @default(autoincrement())
  role_id     Int       @unique
  is_approver Boolean?  @default(false)
  is_cc       Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  roles       roles     @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
}

// Mirrors tender_extension_settings, but for who may run the Award action
// (Closed -> Awarded). Same reasoning as EOT approval: kept purely
// role-configurable rather than hardcoded, and deliberately NOT bypassed by
// isSuperUser (Admin/Developer) — see canApproveAward() in permissions.ts.
// No is_cc column: award decision emails have no CC concept today.
model tender_award_settings {
  id          Int       @id @default(autoincrement())
  role_id     Int       @unique
  is_approver Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  roles       roles     @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
}

model notification_event_settings {
  event_type    String   @id @db.VarChar(50)
  label         String   @db.VarChar(150)
  email_enabled Boolean  @default(true)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
  updated_by    Int?
  users         users?   @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model tender_message {
  message_id                                Int      @id @default(autoincrement())
  tender_id                                 Int
  contractor_id                             Int
  sender_id                                 Int
  is_announcement                           Boolean  @default(false)
  body                                      String
  created_at                                DateTime @default(now()) @db.Timestamp(6)
  users_tender_message_contractor_idTousers users    @relation("tender_message_contractor_idTousers", fields: [contractor_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_tender_message_sender_idTousers     users    @relation("tender_message_sender_idTousers", fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tender                                    tender   @relation(fields: [tender_id], references: [tender_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tender_id, contractor_id, created_at], map: "idx_tender_message_thread")
}
