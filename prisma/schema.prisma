model user_profile {
  profile_id   Int      @id @default(autoincrement())
  user_id      Int      @unique
  full_name    String?  @db.VarChar(200)
  company_name String?  @db.VarChar(200)
  department   String?  @db.VarChar(100)
  job_title    String?  @db.VarChar(100)
  phone        String?  @db.VarChar(30)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_roles {
  user_id                             Int
  role_id                             Int
  assigned_by                         Int?
  assigned_at                         DateTime? @default(now()) @db.Timestamp(6)
  users_user_roles_assigned_byTousers users?    @relation("user_roles_assigned_byTousers", fields: [assigned_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  roles                               roles     @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
  users_user_roles_user_idTousers     users     @relation("user_roles_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

// ============================================
// UPDATED USERS MODEL WITH LOCKOUT & HISTORY
// ============================================
model users {
  user_id                                                                 Int                         @id @default(autoincrement())
  role_id                                                                 Int
  username                                                                String                      @unique @db.VarChar(100)
  email                                                                   String                      @unique @db.VarChar(150)
  password_hash                                                           String                      @db.VarChar(255)
  is_active                                                               Boolean                     @default(true)
  is_approved                                                             Boolean                     @default(false)
  is_deleted                                                              Boolean                     @default(false)
  last_login                                                              DateTime?                   @db.Timestamp(6)
  deleted_at                                                              DateTime?                   @db.Timestamp(6)
  created_at                                                              DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                                                              DateTime                    @default(now()) @db.Timestamp(6)
  access_start_date                                                       DateTime?                   @db.Date
  access_end_date                                                         DateTime?                   @db.Date
  is_team_member                                                          Boolean?                    @default(false)
  employee_code                                                           String?                     @db.VarChar(50)
  job_title                                                               String?                     @db.VarChar(100)
  must_change_password                                                    Boolean?                    @default(true)
  dashboard_layout                                                        Json?

  // ===== NEW FIELDS: Account lockout =====
  failed_login_attempts Int?                                              @default(0)
  locked_until          DateTime?                                         @db.Timestamp(6)
  last_failed_attempt   DateTime?                                         @db.Timestamp(6)
  // ========================================

  // ===== NEW RELATION: password history =====
  password_history      password_history[]

  // ------------------ Existing relations ------------------
  approval_history                                                        approval_history[]
  approval_requests                                                       approval_requests[]
  audit_log                                                               audit_log[]
  auth_refresh_token                                                      auth_refresh_token[]
  bq_draft_snapshot                                                       bq_draft_snapshot[]
  calendar_events                                                         calendar_events[]
  email_notification_log                                                  email_notification_log[]
  interest_document                                                       interest_document[]
  login_history                                                           login_history[]
  negotiation_log_negotiation_log_contractor_idTousers                    negotiation_log[]           @relation("negotiation_log_contractor_idTousers")
  negotiation_log_negotiation_log_logged_byTousers                        negotiation_log[]           @relation("negotiation_log_logged_byTousers")
  password_reset_tokens                                                   password_reset_tokens[]
  past_project_upload                                                     past_project_upload[]
  reno_comparison                                                         reno_comparison[]
  reno_comparison_item                                                    reno_comparison_item[]
  resubmission_request_resubmission_request_contractor_idTousers          resubmission_request[]      @relation("resubmission_request_contractor_idTousers")
  resubmission_request_resubmission_request_requested_byTousers           resubmission_request[]      @relation("resubmission_request_requested_byTousers")
  review_comment                                                          review_comment[]
  submission_review_submission_review_granted_access_toTousers            submission_review[]         @relation("submission_review_granted_access_toTousers")
  submission_review_submission_review_reviewed_byTousers                  submission_review[]         @relation("submission_review_reviewed_byTousers")
  tender                                                                  tender[]
  tender_acknowledgments                                                  tender_acknowledgment[]
  tender_award_tender_award_awarded_byTousers                             tender_award[]              @relation("tender_award_awarded_byTousers")
  tender_award_tender_award_winning_contractor_idTousers                  tender_award[]              @relation("tender_award_winning_contractor_idTousers")
  tender_contractor_tender_contractor_approved_byTousers                  tender_contractor[]         @relation("tender_contractor_approved_byTousers")
  tender_contractor_tender_contractor_contractor_idTousers                tender_contractor[]         @relation("tender_contractor_contractor_idTousers")
  tender_document                                                         tender_document[]
  tender_document_download                                                tender_document_download[]
  tender_extension_requests_tender_extension_requests_approved_byTousers  tender_extension_requests[] @relation("tender_extension_requests_approved_byTousers")
  tender_extension_requests_tender_extension_requests_requested_byTousers tender_extension_requests[] @relation("tender_extension_requests_requested_byTousers")
  tender_interest_tender_interest_approved_byTousers                      tender_interest[]           @relation("tender_interest_approved_byTousers")
  tender_interest_tender_interest_contractor_idTousers                    tender_interest[]           @relation("tender_interest_contractor_idTousers")
  tender_requests                                                         tender_requests[]
  tender_submission                                                       tender_submission[]
  user_profile                                                            user_profile?
  user_roles_user_roles_assigned_byTousers                                user_roles[]                @relation("user_roles_assigned_byTousers")
  user_roles_user_roles_user_idTousers                                    user_roles[]                @relation("user_roles_user_idTousers")
  role                                                                    role                        @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active, is_deleted], map: "idx_users_active")
}

model users_backup {
  user_id              Int?
  role_id              Int?
  username             String?   @db.VarChar(100)
  email                String?   @db.VarChar(150)
  password_hash        String?   @db.VarChar(255)
  is_active            Boolean?
  is_approved          Boolean?
  is_deleted           Boolean?
  last_login           DateTime? @db.Timestamp(6)
  deleted_at           DateTime? @db.Timestamp(6)
  created_at           DateTime? @db.Timestamp(6)
  updated_at           DateTime? @db.Timestamp(6)
  access_start_date    DateTime? @db.Date
  access_end_date      DateTime? @db.Date
  is_team_member       Boolean?
  employee_code        String?   @db.VarChar(50)
  job_title            String?   @db.VarChar(100)
  must_change_password Boolean?

  @@ignore
}

model work_category {
  category_id          Int                    @id @default(autoincrement()) @db.SmallInt
  category_name        String                 @unique @db.VarChar(120)
  sort_order           Int                    @default(0) @db.SmallInt
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  bq_line_item         bq_line_item[]
  submission_category  submission_category[]
  tender_work_category tender_work_category[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tender_extension_requests {
  id                                                  Int       @id @default(autoincrement())
  tender_id                                           Int
  requested_by                                        Int
  requested_days                                      Int
  reason                                              String
  original_closing_date                               DateTime  @db.Timestamp(6)
  proposed_closing_date                               DateTime  @db.Timestamp(6)
  status                                              String?   @default("Pending") @db.VarChar(20)
  approved_by                                         Int?
  approved_at                                         DateTime? @db.Timestamp(6)
  created_at                                          DateTime? @default(now()) @db.Timestamp(6)
  updated_at                                          DateTime? @default(now()) @db.Timestamp(6)
  users_tender_extension_requests_approved_byTousers  users?    @relation("tender_extension_requests_approved_byTousers", fields: [approved_by], references: [user_id], onUpdate: NoAction)
  users_tender_extension_requests_requested_byTousers users     @relation("tender_extension_requests_requested_byTousers", fields: [requested_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  tender                                              tender    @relation(fields: [tender_id], references: [tender_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_extension_status")
  @@index([tender_id], map: "idx_extension_tender_id")
}

model tender_extension_settings {
  id          Int       @id @default(autoincrement())
  role_id     Int
  is_approver Boolean?  @default(false)
  is_cc       Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  role        role      @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
}