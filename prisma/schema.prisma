generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tender {
  tender_id                 Int                         @id @default(autoincrement())
  branch_id                 Int
  renovation_type_id        Int
  status_id                 Int
  created_by                Int
  tender_name               String                      @db.VarChar(150)
  tender_description        String?
  tender_date               DateTime?                   @db.Date
  closing_date              DateTime?                   @db.Date
  renovation_start_date     DateTime?                   @db.Date
  renovation_end_date       DateTime?                   @db.Date
  download_start            DateTime?                   @db.Timestamp(6)
  download_end              DateTime?                   @db.Timestamp(6)
  briefing_date             DateTime?                   @db.Timestamp(6)
  submission_start          DateTime?                   @db.Timestamp(6)
  submission_end            DateTime?                   @db.Timestamp(6)
  estimated_budget          Decimal?                    @db.Decimal(15, 2)
  is_deleted                Boolean                     @default(false)
  deleted_at                DateTime?                   @db.Timestamp(6)
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @default(now()) @updatedAt @db.Timestamp(6)
  project_manager_id        Int?
  handover_date             DateTime?                   @map("handover_date") @db.Date
  liquidated_damages_rate   Int?                        @default(5000)
  defect_liability_months   Int?                        @default(12)
  contract_sum              Decimal?                    @default(0) @db.Decimal
  clauses                   Json?                       @default("{\"scope\": [{\"title\": \"1) SCOPE OF WORKS\", \"description\": \"Supply all materials, labour, plant, equipment and perform all operations necessary to complete the proposed specifications. Prepare shop drawings, samples and mock‑ups when required.\"}, {\"title\": \"2) DISCREPANCIES\", \"description\": \"Material Schedule Chart and Drawings take precedence over Form of Quotation description.\"}, {\"title\": \"3) ADDITIONS AND DELETIONS\", \"description\": \"Extra work approved in writing by Company undertaken based on Contractor's quoted rates as agreed.\"}], \"terms\": [{\"text\": \"The pricing of the Tender including all rates therein, shall be in Singapore Dollars.\", \"header\": \"1) General\"}, {\"text\": \"\", \"header\": \"2) TERMINOLOGIES\"}, {\"text\": \"Company does not bind itself to accept the lowest, the whole or any tender nor is obligated to give reasons for rejection. Company reserves right to accept any tender in part or in whole.\", \"header\": \"3) ACCEPTANCE OF TENDER\"}, {\"text\": \"Contractor shall carry out works to reasonable satisfaction of Company. All Electrical and Plumbing Works adhere to local statutory codes.\", \"header\": \"4) CONTRACTOR'S OBLIGATIONS\"}, {\"text\": \"Contractor takes full responsibility for Company's equipment/properties; any damage made good at Contractor's expense.\", \"header\": \"5) CARE OF COMPANY'S EQUIPMENT / PROPERTIES\"}, {\"text\": \"Contractor indemnifies Company against personal injury, death, property damage arising from works.\", \"header\": \"6) INJURY TO PERSONS AND DAMAGE TO PROPERTY\"}, {\"text\": \"Contractor shall maintain Workmen's Compensation insurance covering all employees.\", \"header\": \"7) WORKER'S COMPENSATION\"}, {\"text\": \"Contractor maintains Public Liability Insurance of at least S$3,000,000 per accident, in joint names of Company, Mall Management and Contractor.\", \"header\": \"8) INSURANCE AGAINST INJURY TO PERSONS AND PROPERTY\"}, {\"text\": \"Company may determine contract if Contractor suspends works, fails to carry out works to satisfaction, persistently neglects to improve after notice, or breaches insurance/indemnity clauses. Bankruptcy or winding‑up automatically terminates contract. Offering gift/inducement to Company officer entitles termination and recovery of losses.\", \"header\": \"9) DETERMINATION OF CONTRACT\"}, {\"text\": \"Contractor provides experienced supervisor present on site during all renovation works.\", \"header\": \"10) CONTRACTOR'S SUPERVISOR\"}, {\"text\": \"Company may order variations by addition or omission; priced using quoted unit rates. Contractor keeps Company representative updated.\", \"header\": \"11) VARIATIONS\"}, {\"text\": \"Failure to complete within specified period incurs liquidated damages of S$5,000 per day (including Sundays & Public Holidays). No extension except at Company's discretion. Contractor to take possession and commence work within one week of Letter of Acceptance.\", \"header\": \"12) LIQUIDATED DAMAGES\"}, {\"text\": \"Main contractor co‑ordinates with all Company's contractors and completes renovation by handover date. Cabinet fabrication done off‑site. Urgent rectification within 24 hours, non‑urgent within 72 hours, otherwise Company may engage others at Contractor's cost.\", \"header\": \"13) COMPLETION PERIOD\"}, {\"text\": \"Progress claims accompanied by detailed itemised statement showing value of works done and materials on site.\", \"header\": \"14) PROGRESS PAYMENT\"}, {\"text\": \"Defects Liability Period one year from handover. Rectification within 24 hours of notification; otherwise liquidated damages S$2,500 per 6 hours delay.\", \"header\": \"15) DEFECTS LIABILITY\"}, {\"text\": \"95% paid on satisfactory completion; balance 5% released within three days after Defects Liability Period, provided defects rectified.\", \"header\": \"16) RETENTION SUM\"}, {\"text\": \"Submit samples, shop drawings and prototypes for approval before proceeding. Setting out of partition line requires approval.\", \"header\": \"17) SAMPLES AND SHOP DRAWINGS\"}, {\"text\": \"Contractor co‑ordinates with other contractors at own cost, gives fullest co‑operation.\", \"header\": \"18) CO-ORDINATION WITH OTHER CONTRACTORS\"}, {\"text\": \"Latest edition of Singapore Institute of Architects – Articles and Conditions of Building Contract for Minor Works applies.\", \"header\": \"19) ARTICLES AND CONDITIONS OF BUILD CONTRACTORS FOR MINOR WORKS\"}, {\"text\": \"Contractor carries out site survey and marking before commencement; final measurements after site marking.\", \"header\": \"20) SITE SURVEY / MARKING\"}, {\"text\": \"Contractor applies to SP Services or other suppliers for testing and turn‑on of power supply.\", \"header\": \"21) INSPECTION AND TESTING OF ELECTRICAL WORKS\"}, {\"text\": \"Stainless steel accessories and ironmongeries for wet areas; stainless steel inlay for floor finishing terminations.\", \"header\": \"22) ACCESSORIES / IRONMONGERIES\"}, {\"text\": \"Submit samples and seek approval for all plumbing works from Company's licensed plumber.\", \"header\": \"23) PLUMBING WORKS\"}, {\"text\": \"Contractor liable for costs imposed by building management for temporary supplies; Company not liable.\", \"header\": \"24) WATER & ELECTRICAL TEMPORARY SUPPLY\"}, {\"text\": \"Proper air balancing after completion with PE endorsement.\", \"header\": \"25) AIR CONDITIONING PROVISIONS\"}, {\"text\": \"Off‑site fabrication limited to local factories and suppliers; Company may reject overseas fabrication.\", \"header\": \"26) OFF-SITE FABRICATION WORKS\"}, {\"text\": \"All items and work comply with applicable laws of Singapore.\", \"header\": \"27) COMPLIANCE WITH REGULATIONS\"}, {\"text\": \"Contractor shall not sub‑contract or assign without written consent.\", \"header\": \"28) SUB-CONTRACTING AND ASSIGNING\"}, {\"text\": \"Company may suspend or determine contract without liability for act of God, riot, strike, etc.\", \"header\": \"29) FORCE MAJEURE\"}, {\"text\": \"No oral variation; only written acceptance by both parties.\", \"header\": \"30) VARIATION OF CONTRACT\"}, {\"text\": \"No rights under Contracts (Rights of Third Parties) Act.\", \"header\": \"31) RIGHTS OF THIRD PARTY\"}], \"critical\": [{\"title\": \"1) TENDER DOCUMENTS\", \"description\": \"All drawings and documents enclosed herewith form part of the whole interior design work. Contractors must strictly adhere to all terms, conditions, and guidelines.\"}, {\"title\": \"2) CRITICAL DATES\", \"description\": \"\"}, {\"title\": \"3) SUBMISSION OF TENDER\", \"description\": \"Tenderers bear all expenses incurred. The Tender, together with all drawings, must be completed and uploaded via the Tender Management System by the closing date and time. Late submissions will not be considered.\"}, {\"title\": \"4) TENDER ENQUIRIES\", \"description\": \"\"}, {\"title\": \"5) GOODS AND SERVICES TAX (G.S.T.)\", \"description\": \"G.S.T. shall be excluded in all contract sums quoted by the Tenderers.\"}, {\"title\": \"6) VALIDITY OF TENDERS\", \"description\": \"Tenders shall remain valid for acceptance for ninety (90) days from the closing date. No withdrawal is permitted within that period. If validity lapses, the Tenderer may withdraw within ten (10) days; otherwise validity extends a further ninety (90) days.\"}, {\"title\": \"7) TERMS OF PAYMENT\", \"description\": \"The Company shall pay the Contractor as follows: (a) Contract Award: 10%; (b) Materials delivered to site: 20%; (c) Interim Payment (70% site completion): 30%; (d) 100% Completion: 35%; (e) Retention Sum (12 months): 5%. The Contractor shall issue progress claims with supporting documents. The Company shall pay within thirty (30) days upon verification. Final Payment only after all defects are rectified and all required documentation (LEW, LP, etc.) is submitted.\"}, {\"title\": \"8) ALTERATIONS TO TEXT\", \"description\": \"Tenderers shall not make any alterations to the Tender Documents without the Company's written approval. Any alteration is null and void.\"}, {\"title\": \"9) NON-PRICING OF ITEMS\", \"description\": \"Items with no value shall have dashes in the \\\"Amount\\\" and \\\"Unit Rate\\\" columns. Blank cells will be deemed included in the next priced item.\"}, {\"title\": \"10) SUFFICIENCY OF UNIT RATES\", \"description\": \"Unit rates shall include all labour, materials, plant, waste, carriage, profit, overheads and everything necessary for proper completion. No variation of tendered price will be allowed.\"}, {\"title\": \"11) ARITHMETICAL ERROR\", \"description\": \"Errors in extension or carry‑forward will be rectified and the total adjusted proportionally.\"}, {\"title\": \"12) INSURANCE\", \"description\": \"Public Liability: min S$2,000,000; All Risk: min S$2,000,000; Workmen's Compensation: full statutory cover. Policies in joint names of Company, Mall Management and Contractor.\"}, {\"title\": \"13) INDEMNITY\", \"description\": \"Contractor indemnifies Company against loss, damage, claim or proceeding arising from personal injury, death, property damage, breach of contract, or unsatisfactory workmanship.\"}, {\"title\": \"14) MATERIALS & FINISHES\", \"description\": \"Submit samples for approval. Alternative material requires written approval; any cost saving adjusts Contract Price. All fixtures safe; electrical conduits concealed; stainless steel hardware.\"}, {\"title\": \"15) LIQUIDATED & ASCERTAINED DAMAGES\", \"description\": \"If Contractor fails to complete by Handover Date, liquidated damages of S$5,000 per whole day (including Sundays & Public Holidays) payable until actual completion. Company may terminate and engage another Contractor at defaulting Contractor's cost.\"}, {\"title\": \"16) DEFECTS LIABILITY PERIOD\", \"description\": \"Twelve (12) months from actual handover of completed site.\"}, {\"title\": \"17) APPROVED FOREIGN WORKERS AT SITE\", \"description\": \"All foreign workers must carry valid work permits. Company not responsible for illegal workers; Contractor indemnifies Company against all related losses.\"}, {\"title\": \"18) TENANT'S GUIDE FOR FITTING OUT WORKS\", \"description\": \"Contractor shall strictly adhere to guidelines of Building Management / Company.\"}, {\"title\": \"19) OWNERSHIP OF CONTRACT DOCUMENTS AND DRAWINGS\", \"description\": \"All signed drawings and material samples shall be returned upon request. Tenderer shall not disclose documents without written consent.\"}, {\"title\": \"20) SPECIALITY WARRANTY\", \"description\": \"Additional three (3) years full warranty on all waterproofing works and materials. Defects rectified within seven (7) days of notification.\"}, {\"title\": \"21) NOTIFICATION OF AWARD\", \"description\": \"Notification will not be sent to unsuccessful Tenderers.\"}]}")
  project_manager_name      String?                     @db.VarChar(150)
  project_manager_email     String?                     @db.VarChar(150)
  project_manager_phone     String?                     @db.VarChar(50)
  bq_template_items         bq_template_items[]
  calendar_events           calendar_events[]
  email_notification_log    email_notification_log[]
  negotiation_log           negotiation_log[]
  past_project              past_project[]
  reno_comparison           reno_comparison?
  resubmission_request      resubmission_request[]
  branch                    branch                      @relation(fields: [branch_id], references: [branch_id], onDelete: NoAction, onUpdate: NoAction)
  users                     users                       @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  project_managers          project_managers?           @relation(fields: [project_manager_id], references: [id], onUpdate: NoAction)
  renovation_type           renovation_type             @relation(fields: [renovation_type_id], references: [type_id], onDelete: NoAction, onUpdate: NoAction)
  tender_status             tender_status               @relation(fields: [status_id], references: [status_id], onDelete: NoAction, onUpdate: NoAction)
  tender_acknowledgments    tender_acknowledgment[]
  tender_award              tender_award?
  tender_contractor         tender_contractor[]
  tender_document           tender_document[]
  tender_extension_requests tender_extension_requests[]
  tender_interest           tender_interest[]
  tender_requests           tender_requests[]
  tender_submission         tender_submission[]
  tender_work_category      tender_work_category[]

  @@index([is_deleted], map: "idx_tender_is_deleted")
  @@index([is_deleted, status_id], map: "idx_tender_is_deleted_status")
  @@index([is_deleted, status_id], map: "idx_tender_status_lookup")
}

model branch {
  branch_id        Int       @id @default(autoincrement())
  brand_id         Int
  branch_name      String    @db.VarChar(100)
  is_deleted       Boolean   @default(false)
  deleted_at       DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  address          String?
  operation_status String    @default("Open") @db.VarChar(50)
  brand            brand     @relation(fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  tenders          tender[]

  @@index([operation_status], map: "idx_branch_operation_status")
}

model brand {
  brand_id        Int               @id @default(autoincrement())
  brand_name      String            @db.VarChar(200)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  branches        branch[]
  calendar_events calendar_events[]
}

model renovation_type {
  type_id           Int                 @id @default(autoincrement())
  type_name         String              @db.VarChar(100)
  description       String?             @db.VarChar(255)
  tenders           tender[]
  tender_submission tender_submission[]
}

model tender_status {
  status_id   Int      @id @default(autoincrement())
  status_code String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  sort_order  Int      @default(0) @db.SmallInt
  tenders     tender[]
}

model bq_line_item {
  line_item_id       Int               @id @default(autoincrement())
  submission_id      Int
  description        String            @db.VarChar(500)
  unit               String?           @db.VarChar(50)
  quantity           Decimal           @default(0) @db.Decimal(12, 3)
  unit_price         Decimal           @default(0) @db.Decimal(15, 2)
  total_price        Decimal?          @default(0) @db.Decimal(15, 2)
  sort_order         Int               @default(0) @db.SmallInt
  created_at         DateTime          @default(now()) @db.Timestamp(6)
  updated_at         DateTime          @default(now()) @db.Timestamp(6)
  category_id        Int?              @db.SmallInt
  location           String?           @db.VarChar(100)
  brand              String?           @db.VarChar(100)
  discount           Decimal           @default(0) @db.Decimal(15, 2)
  specifications     String?
  amount             Decimal?          @db.Decimal(15, 2)
  parent_item_id     Int?
  level              Int               @default(0)
  work_category      work_category?    @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  submission         tender_submission @relation(fields: [submission_id], references: [submission_id], onDelete: NoAction, onUpdate: NoAction)
  bq_line_item       bq_line_item?     @relation("bq_line_itemTobq_line_item", fields: [parent_item_id], references: [line_item_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bq_line_item_parent")
  other_bq_line_item bq_line_item[]    @relation("bq_line_itemTobq_line_item")

  @@index([category_id], map: "idx_bq_line_item_category")
  @@index([level], map: "idx_bq_line_item_level")
  @@index([parent_item_id], map: "idx_bq_line_item_parent")
  @@index([submission_id, category_id], map: "idx_bq_line_item_sub_cat")
  @@index([submission_id], map: "idx_bq_line_item_submission")
  @@index([submission_id, category_id], map: "idx_bq_line_item_submission_category")
}

model tender_acknowledgment {
  id              Int       @id @default(autoincrement())
  tender_id       Int
  contractor_id   Int
  acknowledged_at DateTime? @default(now()) @db.Timestamp(6)
  signature       String    @db.VarChar(255)
  sections        Json?
  contractor      users     @relation(fields: [contractor_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  tender          tender    @relation(fields: [tender_id], references: [tender_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tender_id, contractor_id])
}

model approval_chains {
  chain_id         Int       @id @default(autoincrement())
  resource_type    String    @db.VarChar(50)
  step_order       Int
  role_id          Int?
  can_approve      Boolean?  @default(true)
  can_reject       Boolean?  @default(true)
  requires_comment Boolean?  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  deadline_hours   Int?
  roles            roles?    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
}

model approval_history {
  history_id        Int                @id @default(autoincrement())
  request_id        Int?
  step_order        Int
  approver_id       Int?
  decision          String             @db.VarChar(10)
  comment           String?
  created_at        DateTime?          @default(now()) @db.Timestamp(6)
  users             users?             @relation(fields: [approver_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  approval_requests approval_requests? @relation(fields: [request_id], references: [request_id], onDelete: Cascade, onUpdate: NoAction)
}

model approval_requests {
  request_id       Int                @id @default(autoincrement())
  resource_type    String             @db.VarChar(50)
  resource_id      Int
  requester_id     Int?
  current_step     Int?               @default(1)
  status           String?            @default("pending") @db.VarChar(20)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  approval_history approval_history[]
  users            users?             @relation(fields: [requester_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model audit_log {
  audit_id   Int       @id @default(autoincrement())
  table_name String    @db.VarChar(100)
  record_id  Int
  action     String    @db.VarChar(20)
  old_data   Json?
  new_data   Json?
  changed_by Int?
  changed_at DateTime? @default(now()) @db.Timestamp(6)
  ip_address String?   @db.Inet
  user_agent String?
  users      users?    @relation(fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([changed_at], map: "idx_audit_log_changed_at")
  @@index([table_name, record_id], map: "idx_audit_log_record")
}

model auth_refresh_token {
  token_id                                                                          Int                  @id @default(autoincrement())
  user_id                                                                           Int
  refresh_token_hash                                                                String
  session_id                                                                        String?              @db.VarChar(100)
  expires_at                                                                        DateTime             @db.Timestamp(6)
  is_revoked                                                                        Boolean              @default(false)
  previous_token_id                                                                 Int?
  next_token_id                                                                     Int?
  created_at                                                                        DateTime             @default(now()) @db.Timestamp(6)
  created_by_ip                                                                     String?              @db.Inet
  created_by_user_agent                                                             String?
  last_used_at                                                                      DateTime?            @db.Timestamp(6)
  last_used_ip                                                                      String?              @db.Inet
  last_used_user_agent                                                              String?
  token_purpose                                                                     String?              @default("REFRESH") @db.VarChar(20)
  auth_refresh_token_auth_refresh_token_next_token_idToauth_refresh_token           auth_refresh_token?  @relation("auth_refresh_token_next_token_idToauth_refresh_token", fields: [next_token_id], references: [token_id], onUpdate: NoAction, map: "fk_auth_refresh_token_next")
  other_auth_refresh_token_auth_refresh_token_next_token_idToauth_refresh_token     auth_refresh_token[] @relation("auth_refresh_token_next_token_idToauth_refresh_token")
  auth_refresh_token_auth_refresh_token_previous_token_idToauth_refresh_token       auth_refresh_token?  @relation("auth_refresh_token_previous_token_idToauth_refresh_token", fields: [previous_token_id], references: [token_id], onUpdate: NoAction, map: "fk_auth_refresh_token_previous")
  other_auth_refresh_token_auth_refresh_token_previous_token_idToauth_refresh_token auth_refresh_token[] @relation("auth_refresh_token_previous_token_idToauth_refresh_token")
  users                                                                             users                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_refresh_token_user")

  @@index([refresh_token_hash], map: "idx_auth_refresh_token_hash")
  @@index([session_id], map: "idx_auth_refresh_token_session_id")
  @@index([user_id], map: "idx_auth_refresh_token_user_id")
}

model bq_draft_snapshot {
  snapshot_id       Int               @id @default(autoincrement())
  submission_id     Int
  saved_by          Int
  snapshot_data     Json
  saved_at          DateTime          @default(now()) @db.Timestamp(6)
  users             users             @relation(fields: [saved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tender_submission tender_submission @relation(fields: [submission_id], references: [submission_id], onDelete: NoAction, onUpdate: NoAction)
}

model bq_section {
  section_id        Int               @id @default(autoincrement())
  submission_id     Int
  section_name      String            @db.VarChar(200)
  sort_order        Int               @default(0) @db.SmallInt
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @default(now()) @db.Timestamp(6)
  tender_submission tender_submission @relation(fields: [submission_id], references: [submission_id], onDelete: NoAction, onUpdate: NoAction)
}

model bq_submission_categories {
  id            Int @id @default(autoincrement())
  submission_id Int
  category_id   Int

  @@unique([submission_id, category_id])
}

model bq_submission_items {
  submission_id     Int
  template_item_id  Int
  quantity          Decimal?          @default(0) @db.Decimal(12, 2)
  rate              Decimal?          @default(0) @db.Decimal(12, 2)
  amount            Decimal?          @default(0) @db.Decimal(12, 2)
  updated_at        DateTime?         @default(now()) @db.Timestamp(6)
  tender_submission tender_submission @relation(fields: [submission_id], references: [submission_id], onDelete: Cascade, onUpdate: NoAction)
  bq_template_items bq_template_items @relation(fields: [template_item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([submission_id, template_item_id])
}

model bq_template_items {
  item_id                 Int                   @id @default(autoincrement())
  tender_id               Int
  category_id             Int
  description             String
  unit                    String                @db.VarChar(50)
  sort_order              Int?                  @default(0)
  created_at              DateTime?             @default(now()) @db.Timestamp(6)
  updated_at              DateTime?             @default(now()) @db.Timestamp(6)
  parent_item_id          Int?
  quantity                Decimal?              @db.Decimal(10, 2)
  rate                    Decimal?              @default(0) @db.Decimal
  bq_submission_items     bq_submission_items[]
  bq_template_items       bq_template_items?    @relation("bq_template_itemsTobq_template_items", fields: [parent_item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
  other_bq_template_items bq_template_items[]   @relation("bq_template_itemsTobq_template_items")
  tender                  tender                @relation(fields: [tender_id], references: [tender_id], onDelete: Cascade, onUpdate: NoAction)
}

model calendar_events {
  event_id    Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  start_date  DateTime  @db.Timestamp(6)
  end_date    DateTime? @db.Timestamp(6)
  all_day     Boolean?  @default(false)
  brand_id    Int?
  tender_id   Int?
  event_type  String?   @default("milestone") @db.VarChar(50)
  location    String?   @db.VarChar(255)
  color       String?   @db.VarChar(7)
  created_by  Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  is_deleted  Boolean?  @default(false)
  branch_id   Int?
  brand       brand?    @relation(fields: [brand_id], references: [brand_id], onUpdate: NoAction)
  users       users     @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tender      tender?   @relation(fields: [tender_id], references: [tender_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([brand_id], map: "idx_calendar_events_brand")
  @@index([tender_id], map: "idx_calendar_events_tender")
}

model email_notification_log {
  log_id            Int      @id @default(autoincrement())
  tender_id         Int?
  recipient_user_id Int?
  event_type        String   @db.VarChar(80)
  recipient_email   String   @db.VarChar(150)
  is_delivered      Boolean  @default(false)
  sent_at           DateTime @default(now()) @db.Timestamp(6)
  users             users?   @relation(fields: [recipient_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  tender            tender?  @relation(fields: [tender_id], references: [tender_id], onDelete: NoAction, onUpdate: NoAction)
}

model finance_budget_summary {
  summary_id          Int               @id @default(autoincrement())
  review_id           Int               @unique
  submission_id       Int
  total_submitted     Decimal           @db.Decimal(15, 2)
  recommended_ceiling Decimal?          @db.Decimal(15, 2)
  category_breakdown  Json?
  notes               String?
  created_at          DateTime          @default(now()) @db.Timestamp(6)
  updated_at          DateTime          @default(now()) @db.Timestamp(6)
